{
  "name": "openmontage-studio",
  "productName": "OpenMontage Studio",
  "version": "2.0.0",
  "description": "OpenMontage Studio \u2014 desktop canvas for agentic video production (bring your own AI agent)",
  "license": "AGPL-3.0-or-later",
  "author": "OpenMontage Studio",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "node scripts/bundle-engine.js && electron-builder",
    "build:mac": "node scripts/bundle-engine.js && electron-builder --mac",
    "build:win": "node scripts/bundle-engine.js && electron-builder --win",
    "build:linux": "node scripts/bundle-engine.js && electron-builder --linux",
    "check": "node scripts/check.js",
    "postinstall": "node scripts/postinstall.js",
    "bundle": "node scripts/bundle-engine.js"
  },
  "build": {
    "appId": "com.openmontage.studio",
    "productName": "OpenMontage Studio",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "src/**/*",
      "resources/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/@hyperframes/**",
      "**/node_modules/@puppeteer/**",
      "**/node_modules/gsap/**",
      "**/node_modules/hyperframes/**",
      "**/node_modules/node-pty/**",
      "src/addons/**"
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": [
        {
          "target": "dmg"
        }
      ],
      "icon": "resources/icon.png",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "OpenMontage Studio uses the microphone for voice input: speak your instructions and they are typed for your AI agent."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis"
        }
      ],
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "icon": "resources/icon.png",
      "maintainer": "OpenMontage Studio"
    },
    "extraResources": [
      {
        "from": "vendor/${os}-${arch}",
        "to": "bundle",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "dependencies": {
    "@hyperframes/player": "^0.9.36",
    "gsap": "^3.15.1",
    "hyperframes": "^0.9.36",
    "js-yaml": "^4.3.2"
  },
  "optionalDependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "node-pty@1.1.0": true
  }
}
